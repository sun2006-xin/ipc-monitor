{
  "_comment_": "开源示例配置 — 复制为 data/config.json 后改成自己的摄像头账号密码（data/config.json 已在 .gitignore 忽略，不会被提交）",
  "devices": [],
  "layout": {
    "rows": 2,
    "cols": 2
  },
  "detection": {
    "face_interval": 5,
    "motion_interval": 5,
    "face_threshold": 0.25,
    "motion_min_area": 1500,
    "face_remove_timeout": 30
  },
  "alarm": {
    "sound_enabled": true,
    "sound_file": "resources/sounds/alarm.wav",
    "popup_enabled": false,
    "status_bar_style": "red"
  },
  "language": "zh",
  "recording": {
    "save_path": "data/records"
  },
  "logs": {
    "max_size_mb": 50,
    "max_backup": 5
  }
}
